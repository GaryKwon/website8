{
  "name": "codeharmony",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Code-driven generative instrumental music, entirely in your browser.",
  "scripts": {
    "dev": "npm run build && node scripts/serve.mjs dist",
    "dev:vite": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "build:vite": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "node scripts/serve.mjs dist",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {"node": ">=20.19.0"}
}
