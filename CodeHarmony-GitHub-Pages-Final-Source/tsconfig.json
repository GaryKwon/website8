{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler", "rootDir": "src", "outDir": "dist/assets", "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "noEmitOnError": true, "skipLibCheck": true, "noUncheckedIndexedAccess": false, "useDefineForClassFields": true, "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
